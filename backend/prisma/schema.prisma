// COMMERCIA Prisma Schema — Modèle de données complet
// Copilote financier pour micro-entrepreneurs africains

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===================== UTILISATEURS =====================

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  locale        String   @default("fr")
  currency      String   @default("XAF")
  isAdmin       Boolean  @default(false)
  isActive      Boolean  @default(true)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businesses     BusinessMember[]
  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  aiConversations AIConversation[]
  subscription   Subscription?
  cashSessions   CashSession[]
  payments       Payment[]
}


model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ===================== ENTREPRISES =====================

model Business {
  id          String   @id @default(uuid())
  name        String
  sector      String   // commerce, restaurant, beaute, artisanat, services, vente_en_ligne, autre
  trackingMode String  @default("simple") // simple, avec_stock, avec_credit, complet
  dailySalesEstimate String? // fourchette estimée
  logoUrl     String?
  address     String?
  phone       String?
  currency    String   @default("XAF")
  profileId   String   @default("epicerie_alimentation")
  activeModules String @default("[]")
  salesChannels String @default("[\"boutique\"]")
  businessConfig String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members           BusinessMember[]
  settings          BusinessSettings?
  sales             Sale[]
  expenses          Expense[]
  customers         Customer[]
  products          Product[]
  expenseCategories ExpenseCategory[]
  dashboardSnapshots DashboardSnapshot[]
  analyticsEvents   AnalyticsEvent[]
  aiInsights        AIInsight[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  cashSessions      CashSession[]
  cashMovements     CashMovement[]
  acquisitionChannels AcquisitionChannel[]
  acquisitionCampaigns AcquisitionCampaign[]
  commercialLotCampaigns CommercialLotCampaign[]
  recipes           Recipe[]
  mealPreparations  MealPreparation[]
  serviceOrders     ServiceOrder[]
  mobileMoneyOperations MobileMoneyOperation[]
}


model BusinessMember {
  id         String   @id @default(uuid())
  userId     String
  businessId String
  role       String   @default("owner") // owner, manager, employee
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model BusinessSettings {
  id                String   @id @default(uuid())
  businessId        String   @unique
  enableStock       Boolean  @default(false)
  enableCredits     Boolean  @default(false)
  enableNotifications Boolean @default(true)
  lowStockThreshold Int      @default(5)
  weeklyReportDay   Int      @default(1) // 1=Monday
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ===================== VENTES =====================

model Sale {
  id            String   @id @default(uuid())
  businessId    String
  customerId    String?
  channelId     String?
  campaignId    String?
  totalAmount   Float
  paidAmount    Float
  discountAmount Float   @default(0)
  variableCosts Float    @default(0)
  paymentMethod String   @default("cash") // cash, mobile_money, bank_transfer, credit
  status        String   @default("completed") // completed, pending, cancelled, refunded, delivered
  notes         String?
  saleDate      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  channel  AcquisitionChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaign AcquisitionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  items    SaleItem[]
}

model SaleItem {
  id            String @id @default(uuid())
  saleId        String
  productId     String?
  name          String
  quantity      Int    @default(1)
  unitPrice     Float
  costPrice     Float  @default(0)
  variableCosts Float  @default(0)
  totalPrice    Float

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

// ===================== DÉPENSES =====================

model Expense {
  id          String   @id @default(uuid())
  businessId  String
  categoryId  String?
  channelId   String?
  campaignId  String?
  amount      Float
  description String?
  category    String   @default("autre") // marchandise, transport, loyer, electricite, telephone, salaires, livraison, publicite, autre
  isAcquisition Boolean @default(false)
  isFixedCost   Boolean @default(false)
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id])
  channel         AcquisitionChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  campaign        AcquisitionCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
}

model ExpenseCategory {
  id         String   @id @default(uuid())
  businessId String
  name       String
  icon       String?
  color      String?
  createdAt  DateTime @default(now())

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expenses Expense[]
}

// ===================== CLIENTS =====================

model Customer {
  id             String   @id @default(uuid())
  businessId     String
  firstChannelId String?
  name           String
  phone          String?
  email          String?
  notes          String?
  totalBought    Float    @default(0)
  totalOwed      Float    @default(0)
  acquiredAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  firstChannel AcquisitionChannel? @relation(fields: [firstChannelId], references: [id], onDelete: SetNull)
  sales        Sale[]
  debts        CustomerDebt[]
  payments     CustomerPayment[]
  serviceOrders ServiceOrder[]
}

model CustomerDebt {
  id          String   @id @default(uuid())
  customerId  String
  amount      Float
  description String?
  dueDate     DateTime?
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments CustomerPayment[]
}

model CustomerPayment {
  id         String   @id @default(uuid())
  customerId String
  debtId     String?
  amount     Float
  method     String   @default("cash")
  notes      String?
  paidAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  debt     CustomerDebt? @relation(fields: [debtId], references: [id])
}

// ===================== STOCK / PRODUITS =====================

model Product {
  id              String   @id @default(uuid())
  businessId      String
  name            String
  reference       String?
  category        String?
  description     String?
  costPrice       Float    @default(0)
  sellingPrice    Float    @default(0)
  variableCosts   Float    @default(0) // charges variables unitaires (transport, emballage, commission, etc.)
  variableCostsBreakdown String?      // JSON breakdown: { transport: 0, packaging: 0, delivery: 0, fees: 0, commission: 0, other: 0 }
  quantity        Int      @default(0)
  unit            String   @default("unité")
  lowStockAlert   Int      @default(5)
  isActive        Boolean  @default(true)
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleItems         SaleItem[]
  inventoryMovements InventoryMovement[]
  recipeIngredients RecipeIngredient[]
}

model InventoryMovement {
  id          String   @id @default(uuid())
  productId   String
  type        String   // in, out, adjustment
  quantity    Int
  unitCost    Float?
  reason      String?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ===================== ANALYTICS =====================

model DashboardSnapshot {
  id              String   @id @default(uuid())
  businessId      String
  date            DateTime
  totalSales      Float    @default(0)
  totalExpenses   Float    @default(0)
  estimatedProfit Float    @default(0)
  totalDebt       Float    @default(0)
  salesCount      Int      @default(0)
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  businessId String
  eventType  String
  eventData  String?  // JSON string
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ===================== IA =====================

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // user, assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIInsight {
  id         String   @id @default(uuid())
  businessId String
  type       String   // anomaly, opportunity, stock, profitability, credit
  title      String
  message    String
  severity   String   @default("info") // info, warning, success, danger
  isRead     Boolean  @default(false)
  expiresAt  DateTime?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ===================== ABONNEMENTS =====================

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique // free, pro, business
  displayName String
  description String?
  priceMonthly Float   @default(0)
  priceYearly  Float   @default(0)
  currency     String  @default("XAF")
  features    String   // JSON array of features
  limits      String   // JSON object of limits
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
  payments      Payment[]
}

model Subscription {
  id            String    @id @default(uuid())
  userId        String    @unique
  planId        String
  status        String    @default("free") // free, active, expired, cancelled, trial
  startDate     DateTime  @default(now())
  endDate       DateTime?
  trialEndsAt   DateTime?
  autoRenew     Boolean   @default(false)
  lastPaymentId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   Plan @relation(fields: [planId], references: [id])
  events SubscriptionEvent[]
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String
  eventType      String   // created, renewed, cancelled, upgraded, downgraded
  metadata       String?  // JSON
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String    @id @default(uuid())
  userId            String
  planId            String?
  amount            Float
  currency          String    @default("XAF")
  method            String    // mobile_money, card, bank_transfer
  provider          String    @default("cinetpay") // cinetpay, notchpay, manual_admin
  status            String    @default("pending") // pending, completed, failed, cancelled, refunded
  reference         String    @unique
  providerReference String?
  phoneNumber       String?
  payerEmail        String?
  checkoutUrl       String?
  errorMessage      String?
  metadata          String?   // JSON
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id])
}

model Invoice {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  currency  String   @default("XAF")
  status    String   @default("pending") // pending, paid, overdue
  dueDate   DateTime
  paidAt    DateTime?
  metadata  String?  // JSON
  createdAt DateTime @default(now())
}

// ===================== NOTIFICATIONS =====================

model Notification {
  id         String   @id @default(uuid())
  userId     String
  businessId String?
  type       String   // stock_low, debt_reminder, sales_up, expenses_high, report_ready
  title      String
  message    String
  icon       String?
  isRead     Boolean  @default(false)
  actionUrl  String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id])
}

// ===================== AUDIT =====================

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  businessId String?
  action     String   // create, update, delete, login, logout
  entity     String   // sale, expense, customer, product, etc.
  entityId   String?
  details    String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id])
}

// ===================== CAISSE JOURNALIÈRE =====================

model CashSession {
  id                String    @id @default(uuid())
  businessId        String
  userId            String
  status            String    @default("open") // open, closed
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  initialCash       Float     @default(0) // fond de caisse initial
  totalCashIn       Float     @default(0) // ventes cash + entrées manuelles
  totalCashOut      Float     @default(0) // dépenses cash + sorties manuelles
  totalMomoIn       Float     @default(0) // ventes mobile money
  theoreticalCash   Float     @default(0) // initialCash + totalCashIn - totalCashOut
  actualCash        Float?    // compté physiquement dans le tiroir
  actualMomo        Float?    // solde pointé sur le compte MoMo
  cashDiscrepancy   Float?    // actualCash - theoreticalCash (écart)
  discrepancyReason String?   // explication de l'écart
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements CashMovement[]
}

model CashMovement {
  id          String   @id @default(uuid())
  sessionId   String
  businessId  String
  type        String   // in, out
  amount      Float
  method      String   @default("cash") // cash, mobile_money, bank_transfer
  category    String   // sale, debt_payment, expense, manual_deposit, manual_withdrawal
  referenceId String?  // id de la vente, de la dépense ou du paiement
  description String?
  createdAt   DateTime @default(now())

  session  CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ===================== CANAUX D'ACQUISITION & CAC =====================

model AcquisitionChannel {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  type        String   @default("other") // paid_social, organic, search, direct, referral, influencer, affiliation, other
  description String?
  color       String?  @default("#0062FF")
  icon        String?  @default("Globe")
  isActive    Boolean  @default(true)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaigns AcquisitionCampaign[]
  sales     Sale[]
  expenses  Expense[]
  customers Customer[]

  @@unique([businessId, name])
}

model AcquisitionCampaign {
  id            String    @id @default(uuid())
  businessId    String
  channelId     String
  name          String
  startDate     DateTime  @default(now())
  endDate       DateTime?
  budgetPlanned Float     @default(0)
  actualSpend   Float     @default(0)
  leadsCount    Int       @default(0)
  status        String    @default("active") // active, completed, paused, draft
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  channel  AcquisitionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sales    Sale[]
  expenses Expense[]
}

// ===================== MODULE PRO : GESTION DES LOTS COMMERCIAUX =====================

model CommercialLotCampaign {
  id                    String    @id @default(uuid())
  businessId            String
  name                  String
  goodsType             String    // vetements, telephones, chaussures, cosmetiques, electronique, etc.
  description           String?
  supplierName          String?
  originCountry         String?
  purchaseDate          DateTime  @default(now())
  purchaseCurrency      String    @default("XAF")
  exchangeRate          Float     @default(1.0)
  purchasePriceOriginal Float     @default(0)
  purchasePriceXaf      Float     @default(0)
  transportCost         Float     @default(0)
  customsCost           Float     @default(0)
  transactionFees       Float     @default(0)
  packagingCost         Float     @default(0)
  otherSupplyCosts      Float     @default(0)
  totalLandedCost       Float     @default(0)
  costAllocationMethod  String    @default("unit") // unit, value_weighted, custom
  status                String    @default("active") // draft, active, paused, closed
  closedAt              DateTime?
  depletedAt            DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business  Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items     LotItem[]
  sales     LotSale[]
  expenses  LotExpense[]
  movements LotStockMovement[]

  @@index([businessId, status])
}

model LotItem {
  id                   String   @id @default(uuid())
  campaignId           String
  businessId           String
  name                 String
  reference            String?
  category             String?
  variant              String?
  quantityReceived     Int      @default(0)
  quantitySold         Int      @default(0)
  quantityDefective    Int      @default(0)
  quantityRemaining    Int      @default(0)
  estimatedSellingPrice Float   @default(0)
  unitCost             Float    @default(0)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  campaign  CommercialLotCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  saleItems LotSaleItem[]
  movements LotStockMovement[]

  @@index([campaignId])
}

model LotSale {
  id             String        @id @default(uuid())
  campaignId     String
  businessId     String
  saleDate       DateTime      @default(now())
  channel        String        @default("comptoir") // comptoir, whatsapp, facebook, instagram, site_web, autre
  customerName   String?
  customerPhone  String?
  totalAmount    Float         @default(0)
  discountAmount Float         @default(0)
  netAmount      Float         @default(0)
  variableCosts  Float         @default(0)
  paymentMethod  String        @default("cash") // cash, mobile_money, bank_transfer, credit
  paymentStatus  String        @default("paid") // paid, pending, cancelled, refunded
  amountPaid     Float         @default(0)
  amountDue      Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  campaign CommercialLotCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items    LotSaleItem[]

  @@index([campaignId, saleDate])
}

model LotSaleItem {
  id          String  @id @default(uuid())
  saleId      String
  lotItemId   String
  quantity    Int     @default(1)
  unitPrice   Float   @default(0)
  unitCost    Float   @default(0)
  totalPrice  Float   @default(0)
  totalCost   Float   @default(0)
  grossProfit Float   @default(0)

  sale    LotSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lotItem LotItem @relation(fields: [lotItemId], references: [id], onDelete: Cascade)
}

model LotExpense {
  id          String   @id @default(uuid())
  campaignId  String
  businessId  String
  amount      Float
  category    String   @default("autre") // blanchisserie, pressing, reparation, publicite, transport, livraison, autre
  description String?
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  campaign CommercialLotCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model LotStockMovement {
  id         String   @id @default(uuid())
  campaignId String
  lotItemId  String
  type       String   // sale, defective, adjustment, return
  quantity   Int
  reason     String?
  createdAt  DateTime @default(now())

  campaign CommercialLotCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lotItem  LotItem               @relation(fields: [lotItemId], references: [id], onDelete: Cascade)

  @@index([campaignId, lotItemId])
}

// ===================== MODULE RESTAURATION & PRÉPARATION =====================

model Recipe {
  id                      String            @id @default(uuid())
  businessId              String
  name                    String
  description             String?
  category                String?           @default("plat") // entree, plat, dessert, boisson, accompagnement
  portionsYield           Int               @default(1)
  sellingPricePerPortion  Float             @default(0)
  estimatedCostPerPortion Float             @default(0)
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  business                Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ingredients             RecipeIngredient[]
  preparations            MealPreparation[]

  @@index([businessId])
}

model RecipeIngredient {
  id             String   @id @default(uuid())
  recipeId       String
  productId      String?
  name           String
  quantity       Float    @default(1)
  unit           String   @default("kg") // kg, g, l, cl, piece, botte
  unitCost       Float    @default(0)

  recipe         Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([recipeId])
}

model MealPreparation {
  id                    String    @id @default(uuid())
  businessId            String
  recipeId              String?
  dishName              String
  portionsPrepared      Int       @default(0)
  portionsSold          Int       @default(0)
  portionsRemaining     Int       @default(0)
  portionsLost          Int       @default(0)
  portionsOffered       Int       @default(0)
  unitSellingPrice      Float     @default(0)
  totalRevenue          Float     @default(0)
  ingredientsCost       Float     @default(0)
  otherProductionCosts  Float     @default(0)
  preparationDate       DateTime  @default(now())
  status                String    @default("active") // active, closed
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  business              Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recipe                Recipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([businessId, preparationDate])
}

// ===================== MODULE PRESTATIONS, COMMANDES & TRAVAUX =====================

model ServiceOrder {
  id                    String               @id @default(uuid())
  businessId            String
  customerId            String?
  orderNumber           String
  title                 String
  serviceType           String               // couture, reparation, garage, agence, prestation, etc.
  agreedAmount          Float                @default(0)
  advancePaid           Float                @default(0)
  balanceDue            Float                @default(0)
  materialsCost         Float                @default(0)
  laborCost             Float                @default(0)
  otherCosts            Float                @default(0)
  status                String               @default("devis") // devis, confirme, en_cours, pret, termine, livre, annule
  estimatedDeliveryDate DateTime?
  completionDate        DateTime?
  specsJson             String?              // JSON: { measurements: {}, diagnosis: {}, device: "", vehicle: "" }
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer              Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  costs                 ServiceOrderCost[]
  payments              ServiceOrderPayment[]

  @@index([businessId, status])
}

model ServiceOrderCost {
  id          String       @id @default(uuid())
  orderId     String
  category    String       @default("materiel") // materiel, piece, main_d_oeuvre, sous_traitance, transport, autre
  description String
  amount      Float        @default(0)
  createdAt   DateTime     @default(now())

  order       ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ServiceOrderPayment {
  id            String       @id @default(uuid())
  orderId       String
  amount        Float
  paymentMethod String       @default("cash") // cash, mobile_money, bank_transfer, cheque
  notes         String?
  paidAt        DateTime     @default(now())
  createdAt     DateTime     @default(now())

  order         ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ===================== MODULE MOBILE MONEY & COMMISSIONS =====================

model MobileMoneyOperation {
  id               String   @id @default(uuid())
  businessId       String
  operator         String   // orange_money, mtn_momo, wave, moov, autre
  type             String   // depot, retrait, transfert, credit_telephonique, autre
  clientAmount     Float    @default(0) // Montant client en transit (NE PAS COMPTER DANS LE CA)
  commissionEarned Float    @default(0) // COMMISSION RÉELLE ACQUISE (SEUL CA RÉEL DE L'AGENT)
  feeCharged       Float    @default(0) // Frais client facturés
  customerPhone    String?
  customerName     String?
  reference        String?
  status           String   @default("completed") // completed, pending, cancelled
  operationDate    DateTime @default(now())
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, operationDate])
}


